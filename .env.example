# Copy this file to .env and fill in your real values. Never commit .env.

# Get this from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional for Week 1 — you'll use this in Week 2 to verify webhook payloads
# came from GitHub. Set any random string here and match it in your GitHub
# webhook config later.
GITHUB_WEBHOOK_SECRET=
